# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/for_u
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Comma-separated exact browser origins. An empty value denies browser CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=262144

# Authentication. AUTH_MODE=dev is rejected when NODE_ENV=production.
AUTH_MODE=dev
DEV_AUTH_TOKEN=replace-with-a-random-local-token
DEV_USER_ID=person_me
JWT_ISSUER=https://identity.example.com/
JWT_AUDIENCE=for-u-api
JWT_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# Background recommendation worker
# Must be unique per running worker replica (pod/container name is a good value).
WORKER_ID=for-u-worker-local
WORKER_POLL_MS=1000
WORKER_LEASE_MS=60000
WORKER_COMPLETION_MARGIN_MS=5000

# Shared, non-secret API/worker controls and artifact identity. Disabled is the
# fail-closed default; enabling it makes the API queue refinement jobs.
AI_REFINEMENT_ENABLED=false
OPENAI_MODEL=gpt-5.6-sol
RECOMMENDATION_RULES_VERSION=compatibility-rules-v1
AI_PROMPT_VERSION=compatibility-explanation-v1

# Worker-only provider configuration. The key is required only when refinement
# is enabled. Never inject these into the API or expose them as VITE_* variables.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=12000
OPENAI_MAX_ATTEMPTS=2
