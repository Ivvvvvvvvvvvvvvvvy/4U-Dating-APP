{
  "name": "for-u",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:server",
    "build:server": "node scripts/clean-dist.mjs && tsc -b && vite build --outDir dist/client && node scripts/check-client-privacy.mjs dist/client && bash scripts/package-site.sh",
    "build:pages": "node scripts/clean-dist.mjs && tsc -b && vite build --mode pages --outDir dist/pages && node scripts/check-client-privacy.mjs dist/pages",
    "preview": "vite preview --host 0.0.0.0 --outDir dist/client",
    "generate:profiles-public": "node scripts/generate-synthetic-public-data.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:responsive": "node tests/responsive.mjs",
    "test:mobile-overlap": "node tests/mobile-overlap.mjs",
    "test:mobile-product": "node tests/mobile-product-polish.mjs",
    "test:contracts": "node tests/contracts.mjs",
    "test:activities": "node tests/activity-fixtures.mjs",
    "test:profile-avatars": "node tests/profile-avatars.mjs",
    "test:create-activity": "node tests/create-activity.mjs",
    "test:profiles": "node tests/synthetic-profiles.mjs",
    "test:recommendations": "node tests/recommendation-feed.mjs"
  },
  "dependencies": {
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite-plugin-enter-dev": "^0.0.10"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "playwright": "^1.62.1",
    "typescript": "latest",
    "vite": "latest"
  },
  "displayName": "4U"
}
